# ===================================================
# VAULT-X Production Environment Configuration
# ===================================================

# 1. Neon Serverless PostgreSQL Database Connection
# Pooled connection string (Used by Prisma Client in Serverless / Next.js):
DATABASE_URL="postgresql://[user]:[password]@[neon-hostname]-pooler.[region].aws.neon.tech/[dbname]?sslmode=require"

# Direct connection string (Used by Prisma for migrations and schema pushing):
DIRECT_URL="postgresql://[user]:[password]@[neon-hostname].[region].aws.neon.tech/[dbname]?sslmode=require"

# 2. Redis Connection (BullMQ Queue & Distributed Rate Limiter)
REDIS_URL="redis://localhost:6379"

# 3. AES-256-GCM Cryptographic Master Key Vault (256-bit Hex Strings)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MASTER_ENCRYPTION_KEY_V1="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
CURRENT_KEY_VERSION=1

# 4. Payment Gateway Webhook Secrets
PAYSTACK_SECRET_KEY="sk_live_paystack_secret_key_here"
CRYPTO_WEBHOOK_SECRET="crypto_gateway_webhook_secret_here"

# 5. Application Runtime
NODE_ENV="production"
PORT=3000
